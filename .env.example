# ─────────────────────────── Banco (Supabase Postgres) ───────────────────────────
# Painel Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL  = conexão POOLED (Transaction pooler, porta 6543) — usada pela app em runtime.
# DIRECT_URL    = conexão DIRECT (porta 5432) — usada por `prisma migrate` / `prisma studio`.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Opcional: banco separado para o shadow DB das migrations (Supabase normalmente exige).
# Deixe em branco para tentar sem; se `prisma migrate dev` reclamar, aponte para outro banco vazio.
SHADOW_DATABASE_URL=""

# ─────────────────────────── Supabase Auth / Storage ───────────────────────────
# Painel Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Chave secreta (service_role). SÓ no servidor — nunca exposta ao cliente.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
