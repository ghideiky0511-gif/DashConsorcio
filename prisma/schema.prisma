// Dashboard HH Gestão de Consórcio — modelo de dados
// Docs: https://pris.ly/d/prisma-schema
// Prisma 7: generator `prisma-client` (ESM, output em src/generated/prisma);
// URLs do banco ficam em prisma7.config.ts, não neste arquivo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  ADMIN
  OPERADOR
  VISUALIZADOR
}

enum TipoBem {
  IMOVEL
  VEICULO
  SERVICOS
  OUTRO
}

enum StatusConsorcio {
  ATIVA
  CANCELADA
}

enum TipoSaida {
  RESGATE
  REVENDA
}

enum FormaContemplacao {
  SORTEIO
  LANCE
}

enum StatusParcela {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum PapelContraparte {
  CEDENTE
  COMPRADOR_FINAL
  REPRESENTANTE
  OUTRO
}

enum TipoDocumento {
  CONTRATO
  PROCURACAO
  IDENTIFICACAO
  COMPROVANTE
  OUTRO
}

enum TipoDespesa {
  COMISSAO
  DARE
  GUIA_TJ
  CARTORIO
  DIVERSAS
  OUTRO
}

enum TipoMovimento {
  ENTRADA
  SAIDA
}

enum CategoriaMovimento {
  COMPRA_CARTA
  DESPESA_CARTA
  PARCELA
  RESGATE_CARTA
  REVENDA_CARTA
  OUTRO
}

enum MotorPrecificacao {
  ATIVA // consorciado ativo/contemplável — modelo de "sobra" + lance
  CANCELADA // consorciado excluído — compra do direito ao resgate futuro
}

enum IndiceCorrecao {
  IPCA
  INCC
  IGPM
  OUTRO
}

enum MomentoResgate {
  ENCERRAMENTO_GRUPO
  SORTEIO_EXCLUIDOS
  PRAZO_FIXO
}

/// Que tipo de lance a administradora aceita pra contemplar uma cota ativa.
enum TipoLanceAceito {
  /// Só contempla; o saldo devedor continua a pagar em parcelas.
  CONTEMPLACAO
  /// Quita o saldo devedor inteiro junto com a contemplação — mas o crédito só
  /// é liberado depois de um prazo de carência (normalmente 180 dias).
  QUITACAO
  AMBOS
}

// ────────────────────────────── Modelos ──────────────────────────────

/// Espelha auth.users do Supabase; `id` = auth.users.id.
model Profile {
  id        String   @id @db.Uuid
  nome      String
  email     String   @unique
  role      Role     @default(VISUALIZADOR)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartasCriadas   Carta[]          @relation("CartaCriadaPor")
  etapaHistoricos EtapaHistorico[]
  documentos      Documento[]
  precificacoes   Precificacao[]

  @@map("profiles")
}

/// Entidades da HH que adquirem as cartas (coluna "Cessionária").
model Cessionaria {
  id         String   @id @default(uuid()) @db.Uuid
  nome       String   @unique
  cnpj       String?
  observacao String?
  ativa      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cartas Carta[]

  @@map("cessionarias")
}

/// Administradora do consórcio (coluna "ADM").
model Administradora {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String   @unique
  cnpj      String?
  contato   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Regras de resgate para consorciado excluído (usadas pelo precificador).
  indiceCorrecao   IndiceCorrecao?
  resgateCorrigido Boolean         @default(true) // devolve o fundo comum corrigido pelo índice?
  multaExclusaoPct Decimal?        @db.Decimal(7, 4) // fração 0..1 retida do excluído
  momentoResgate   MomentoResgate?

  // Regras de lance para carta ATIVA (usadas pelo precificador).
  tipoLanceAceito            TipoLanceAceito?
  prazoLiberacaoQuitacaoDias Int? // padrão de mercado: 180 dias

  cartas        Carta[]
  precificacoes Precificacao[]

  @@map("administradoras")
}

/// Etapa do pipeline (configurável em /configuracoes).
model Etapa {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  ordem     Int
  cor       String?
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartas        Carta[]
  historicoDe   EtapaHistorico[] @relation("EtapaDe")
  historicoPara EtapaHistorico[] @relation("EtapaPara")

  @@unique([ordem])
  @@map("etapas")
}

/// Carta de consórcio comprada pela HH. Uma linha da planilha = uma Carta.
model Carta {
  id               String  @id @default(uuid()) @db.Uuid
  codigo           String  @unique // "Controle Interno SSA"
  cessionariaId    String  @db.Uuid
  administradoraId String  @db.Uuid
  grupo            String
  cota             String
  contrato         String?
  origem           String? // "Origem (intermediador)"

  tipoBem         TipoBem         @default(OUTRO)
  statusConsorcio StatusConsorcio @default(ATIVA)
  tipoSaida       TipoSaida?
  etapaId         String          @db.Uuid

  // Financeiro
  valorCredito             Decimal  @default(0) @db.Decimal(14, 2) // "Crédito Atual"
  valorCreditoContemplacao Decimal? @db.Decimal(14, 2) // "Valor do Crédito"
  percentualPago           Decimal? @db.Decimal(7, 4) // fração 0..1
  valorCompra              Decimal  @default(0) @db.Decimal(14, 2) // "Custo da Aquisição"
  previsaoResgate          Decimal? @db.Decimal(14, 2) // "Previsão de Resgate (R$)"
  valorResgatado           Decimal? @db.Decimal(14, 2) // "Valor Resgatado em:"
  valorRevenda             Decimal? @db.Decimal(14, 2)

  // Datas-marco do processo
  dataCompra          DateTime? @db.Date
  dataCadastroBolsa   DateTime? @db.Date
  encerramentoGrupo   DateTime? @db.Date
  dataCopiasSeveri    DateTime? @db.Date
  dataOriginaisSeveri DateTime? @db.Date
  dataNotificacao     DateTime? @db.Date
  dataDoctoAdm        DateTime? @db.Date
  dataPedidoResgate   DateTime? @db.Date
  contempladaEm       DateTime? @db.Date
  dataResgate         DateTime? @db.Date
  dataRevenda         DateTime? @db.Date

  formaContemplacao FormaContemplacao?

  // Parcelamento
  parcelasTotais   Int?
  parcelasQuitadas Int?
  parcelaValor     Decimal? @db.Decimal(14, 2)
  diaVencimento    Int?

  observacoes       String? // "OBSERVAÇÃO (Documento pendente, etc)"
  observacoesGerais String?

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cessionaria    Cessionaria      @relation(fields: [cessionariaId], references: [id])
  administradora Administradora   @relation(fields: [administradoraId], references: [id])
  etapa          Etapa            @relation(fields: [etapaId], references: [id])
  createdBy      Profile          @relation("CartaCriadaPor", fields: [createdById], references: [id])
  acesso         AcessoCota?
  despesas       DespesaCarta[]
  parcelas       Parcela[]
  contrapartes   Contraparte[]
  documentos     Documento[]
  etapaHistorico EtapaHistorico[]
  movimentos     MovimentoCaixa[]
  precificacoes  Precificacao[]

  @@index([cessionariaId])
  @@index([administradoraId])
  @@index([etapaId])
  @@index([statusConsorcio])
  @@map("cartas")
}

/// Credenciais de acesso à conta do consorciado (colunas E-mail cadastro / Cota Chave / Celular / Senha).
model AcessoCota {
  id            String   @id @default(uuid()) @db.Uuid
  cartaId       String   @unique @db.Uuid
  emailCadastro String?
  cotaChave     String?
  celular       String?
  senha         String?
  observacao    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  carta Carta @relation(fields: [cartaId], references: [id], onDelete: Cascade)

  @@map("acessos_cota")
}

/// Lançamento de despesa por carta. Comissão / DARE / Guia TJ / Cartório / Diversas viram um lançamento cada.
model DespesaCarta {
  id        String      @id @default(uuid()) @db.Uuid
  cartaId   String      @db.Uuid
  tipo      TipoDespesa
  descricao String?
  valor     Decimal     @db.Decimal(14, 2)
  data      DateTime?   @db.Date
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  carta      Carta            @relation(fields: [cartaId], references: [id], onDelete: Cascade)
  movimentos MovimentoCaixa[]

  @@index([cartaId])
  @@map("despesas_carta")
}

/// Trilha de auditoria do pipeline.
model EtapaHistorico {
  id          String   @id @default(uuid()) @db.Uuid
  cartaId     String   @db.Uuid
  etapaDeId   String?  @db.Uuid
  etapaParaId String   @db.Uuid
  observacao  String?
  data        DateTime @default(now())
  userId      String   @db.Uuid

  carta     Carta   @relation(fields: [cartaId], references: [id], onDelete: Cascade)
  etapaDe   Etapa?  @relation("EtapaDe", fields: [etapaDeId], references: [id])
  etapaPara Etapa   @relation("EtapaPara", fields: [etapaParaId], references: [id])
  user      Profile @relation(fields: [userId], references: [id])

  @@index([cartaId])
  @@map("etapa_historico")
}

/// Parcela mensal a pagar de uma carta.
model Parcela {
  id             String        @id @default(uuid()) @db.Uuid
  cartaId        String        @db.Uuid
  numero         Int
  competencia    DateTime      @db.Date // 1º dia do mês
  vencimento     DateTime      @db.Date
  valorPrevisto  Decimal       @db.Decimal(14, 2)
  status         StatusParcela @default(PENDENTE)
  valorPago      Decimal?      @db.Decimal(14, 2)
  dataPagamento  DateTime?     @db.Date
  formaPagamento String?
  observacao     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  carta      Carta            @relation(fields: [cartaId], references: [id], onDelete: Cascade)
  documentos Documento[]
  movimentos MovimentoCaixa[]

  @@unique([cartaId, numero])
  @@index([vencimento])
  @@index([status])
  @@map("parcelas")
}

/// Pessoas ligadas à carta: cedente (consorciado), comprador final, representante.
model Contraparte {
  id         String           @id @default(uuid()) @db.Uuid
  cartaId    String           @db.Uuid
  papel      PapelContraparte
  nome       String
  documento  String? // CPF/CNPJ
  email      String?
  telefone   String?
  observacao String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  carta      Carta       @relation(fields: [cartaId], references: [id], onDelete: Cascade)
  documentos Documento[]

  @@index([cartaId])
  @@map("contrapartes")
}

/// Arquivo no bucket privado `documentos` do Supabase Storage.
model Documento {
  id            String        @id @default(uuid()) @db.Uuid
  cartaId       String?       @db.Uuid
  parcelaId     String?       @db.Uuid
  contraparteId String?       @db.Uuid
  tipo          TipoDocumento @default(OUTRO)
  nome          String
  storagePath   String
  tamanho       Int
  mimeType      String
  uploadedById  String        @db.Uuid
  createdAt     DateTime      @default(now())

  carta       Carta?       @relation(fields: [cartaId], references: [id], onDelete: Cascade)
  parcela     Parcela?     @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  contraparte Contraparte? @relation(fields: [contraparteId], references: [id], onDelete: Cascade)
  uploadedBy  Profile      @relation(fields: [uploadedById], references: [id])

  @@index([cartaId])
  @@map("documentos")
}

/// Livro-caixa unificado. Alimentado ao pagar parcela / registrar compra / lançar despesa / registrar resgate ou revenda.
model MovimentoCaixa {
  id         String             @id @default(uuid()) @db.Uuid
  tipo       TipoMovimento
  categoria  CategoriaMovimento
  descricao  String
  valor      Decimal            @db.Decimal(14, 2)
  data       DateTime           @db.Date
  cartaId    String?            @db.Uuid
  parcelaId  String?            @db.Uuid
  despesaId  String?            @db.Uuid
  conciliado Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  carta   Carta?        @relation(fields: [cartaId], references: [id], onDelete: SetNull)
  parcela Parcela?      @relation(fields: [parcelaId], references: [id], onDelete: SetNull)
  despesa DespesaCarta? @relation(fields: [despesaId], references: [id], onDelete: SetNull)

  @@index([data])
  @@index([cartaId])
  @@map("movimentos_caixa")
}

/// Configuração singleton do caixa (base da projeção).
model ConfigCaixa {
  id               String   @id @default("singleton")
  saldoInicial     Decimal  @default(0) @db.Decimal(14, 2)
  dataSaldoInicial DateTime @db.Date
  updatedAt        DateTime @updatedAt

  @@map("config_caixa")
}

/// Foto diária das taxas de juros usadas na precificação — mantida para que cada
/// cálculo seja reproduzível mesmo depois de o mercado mudar.
model CurvaJurosSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  data          DateTime @unique @db.Date
  fonte         String // ex.: "BCB SGS 12 + Tesouro Prefixado"
  cdiAnual      Decimal  @db.Decimal(9, 6) // CDI a.a. corrente, fração
  ipcaProjAnual Decimal? @db.Decimal(9, 6) // projeção IPCA (Focus), fração
  /// Curva prefixada: [{ meses: number, taxaAnual: number }] ordenada por prazo.
  pontos        Json
  createdAt     DateTime @default(now())

  precificacoes Precificacao[]

  @@map("curva_juros_snapshot")
}

/// Um cálculo de precificação de carta. Guarda os inputs, as assunções e o
/// resultado — nada é recalculado depois; a carta pode mudar sem afetar o histórico.
model Precificacao {
  id    String            @id @default(uuid()) @db.Uuid
  motor MotorPrecificacao

  // Vínculo opcional: dá para precificar uma carta ainda não cadastrada.
  cartaId          String? @db.Uuid
  administradoraId String? @db.Uuid

  // Snapshot dos dados da carta no momento do cálculo.
  administradoraNome   String?
  grupo                String?
  cota                 String?
  creditoAtual         Decimal   @db.Decimal(14, 2)
  percentualPago       Decimal?  @db.Decimal(7, 4) // fração 0..1 — só carta cancelada
  fundoComumPago       Decimal?  @db.Decimal(14, 2) // base real do resgate, quando o extrato traz
  encerramentoGrupo    DateTime? @db.Date // só carta cancelada
  dataReferencia       DateTime  @db.Date // "hoje" do cálculo
  mesesAteEncerramento Int // cancelada: até o encerramento · ativa: parcelas restantes

  // Assunções.
  indiceCorrecaoAnual Decimal? @db.Decimal(9, 6) // fração — só carta cancelada
  multaExclusaoPct    Decimal  @default(0) @db.Decimal(7, 4)
  metaMultiploCdi     Decimal  @default(2) @db.Decimal(6, 3)
  cdiAcumuladoPeriodo Decimal  @db.Decimal(9, 6) // fração, derivado da curva
  curvaSnapshotId     String?  @db.Uuid

  // Resultado.
  resgateProjetado Decimal  @db.Decimal(14, 2) // cancelada: resgate · ativa: valor nominal total do fluxo
  precoJusto       Decimal? @db.Decimal(14, 2)
  precoOfertado    Decimal? @db.Decimal(14, 2) // o que o operador decidiu propor
  propostaMdv      Decimal? @db.Decimal(14, 2)
  propostaObjetiva Decimal? @db.Decimal(14, 2)
  retornoTotal     Decimal? @db.Decimal(9, 6)
  retornoMensal    Decimal? @db.Decimal(9, 6)
  multiploCdi      Decimal? @db.Decimal(9, 4)
  /// Cenários de sensibilidade: [{ indiceAnual, resgate, retornoTotal, multiploCdi }].
  cenarios         Json?
  /// Dump completo do cálculo para auditoria (fluxo da carta ativa, passos, etc.).
  detalhe          Json?

  observacoes String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  carta          Carta?              @relation(fields: [cartaId], references: [id], onDelete: SetNull)
  administradora Administradora?     @relation(fields: [administradoraId], references: [id], onDelete: SetNull)
  curvaSnapshot  CurvaJurosSnapshot? @relation(fields: [curvaSnapshotId], references: [id], onDelete: SetNull)
  createdBy      Profile             @relation(fields: [createdById], references: [id])

  @@index([cartaId])
  @@index([createdAt])
  @@map("precificacoes")
}
